[Nemo Action]
Name=Add OneLineNote
Name[pl]=Dodaj OneLineNote
Comment=Creates a new sticky note on the desktop
Comment[pl]=Tworzy nową karteczkę samoprzylepną na pulpicie
Icon-Name=text-x-generic-symbolic
Exec=__ONELINENOTES__/bin/note-new
Selection=none
Extensions=any
Quote=none
EscapeSpaces=false
